

{
	"version": 10,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
			}
		},
		{
			"inherits": "base",
			"name": "debug",
			"displayName": "Debug preset",
			"binaryDir": "${sourceDir}/build/debug",
			"cacheVariables":
			{
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -g -O0"
			}
		}
	],
	"buildPresets": [
		{
			"name": "debug",
			"configurePreset": "debug"
		}
	],
	"testPresets": [
		{
			"name": "test-all",
			"displayName": "Test All",
			"configurePreset": "debug",
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"stopOnFailure": false
			}
		}
	]
}
